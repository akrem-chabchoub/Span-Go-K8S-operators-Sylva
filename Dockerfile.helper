FROM rust:1.85-bookworm AS build
WORKDIR /src
COPY helper/Cargo.toml ./Cargo.toml
COPY helper/src ./src
RUN cargo build --release

FROM debian:bookworm-slim
COPY --from=build /src/target/release/span-helper /usr/local/bin/span-helper
ENTRYPOINT ["span-helper"]
CMD ["serve", "--listen", "0.0.0.0:8080", "--link", "span0"]
